# Server Configuration
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/drive_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=drive_db
DB_USER=user
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# Stripe Configuration (Fiat Payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Web3 Configuration
WEB3_PROVIDER_URL=https://sepolia.infura.io/v3/your_infura_project_id
ESCROW_CONTRACT_ADDRESS=0x...
PRIVATE_KEY_FOR_BACKEND=your_backend_wallet_private_key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# External Services
KYC_PROVIDER_API_KEY=your_kyc_provider_api_key
KYC_PROVIDER_URL=https://api.kyc-provider.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000
