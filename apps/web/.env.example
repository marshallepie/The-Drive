# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional internal API URL override for server-side preview routes.
INTERNAL_API_URL=http://localhost:4000

# Frontend URL used in approval emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Preview access request notifications
DRIVE_PREVIEW_ACCESS_NOTIFY_TO=me@marshallepie.com

# Optional webhook for MEPA / automation intake when a request is submitted.
DRIVE_PREVIEW_REQUEST_WEBHOOK_URL=

# Secret required for approval automation to create preview accounts.
DRIVE_PREVIEW_APPROVAL_SECRET=replace_with_a_long_secret

# SMTP configuration for request + approval emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=The Drive <noreply@thedrive.co>

# Analytics (Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_LINKER_DOMAINS=
