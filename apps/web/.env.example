# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000

# Temporary preview gate credentials for the development hold page
# Replace these with issued credentials before deployment.
DRIVE_PREVIEW_USERNAME=preview_username_here
DRIVE_PREVIEW_PASSWORD=preview_password_here

# Web3 Configuration
NEXT_PUBLIC_ENABLE_WEB3=true
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Chain Configuration (Ethereum Mainnet = 1, Sepolia = 11155111)
NEXT_PUBLIC_CHAIN_ID=11155111
